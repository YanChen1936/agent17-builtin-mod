# 只跟踪修改器源码、引擎补丁与 CI 配置，游戏资源全部忽略
/*
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/release.yml
!/.gitignore
!/README.md
!/使用说明.md
!/docs/
/docs/*
!/docs/screenshot-item.png
!/docs/screenshot-search.png
!/game/
/game/*
!/game/script/
/game/script/*
!/game/script/ActorScript/
/game/script/ActorScript/*
!/game/script/ActorScript/cheat_menu.rpy
!/game/script/Menu/
/game/script/Menu/*
!/game/script/Menu/homemenu.rpy
!/renpy/
/renpy/*
!/renpy/audio/
/renpy/audio/*
!/renpy/audio/audio.py
